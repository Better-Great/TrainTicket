# Copy to .env and adjust. Matches properties/dev.application.ini TicketOfficeMysql*.

TICKET_OFFICE_MYSQL_HOST=127.0.0.1
TICKET_OFFICE_MYSQL_PORT=3307
TICKET_OFFICE_MYSQL_USER=beta
TICKET_OFFICE_MYSQL_PASSWORD=beta123
TICKET_OFFICE_MYSQL_DATABASE=ts-ticket-office-mysql

# HTTP (bin/www). Docker image also accepts TICKET_OFFICE_SERVICE_PORT (same as PORT if PORT unset).
PORT=16108
