# ts-ticket-office-service: Node.js/Express service.
# Build from repo root: docker build -f dockerfile/Dockerfile.Ts.Ticket.Office.Service .
# Expects: ts-ticket-office-service/ with package.json, app.js, bin/, public/

FROM node:18-alpine

RUN apk add --no-cache tzdata && \
    cp /usr/share/zoneinfo/Asia/Shanghai /etc/localtime 2>/dev/null || true

RUN addgroup -S app && adduser -S -G app app
WORKDIR /app

COPY ts-ticket-office-service/package.json ts-ticket-office-service/package-lock.json* ./
RUN npm install --omit=dev && npm cache clean --force

COPY ts-ticket-office-service/app.js ./
COPY ts-ticket-office-service/bin ./bin
COPY ts-ticket-office-service/public ./public
RUN chown -R app:app /app
USER app

EXPOSE 16108
CMD ["npm", "start"]
