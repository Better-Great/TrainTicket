# ts-ticket-office-service: Node.js/Express.
# Build from repo root:
#   docker build -f dockerfile/Dockerfile.Ts.Ticket.Office.Service .
# Optional at build: export TICKET_OFFICE_SERVICE_PORT so EXPOSE matches your -p mapping.
# Runtime (required): TICKET_OFFICE_MYSQL_HOST, TICKET_OFFICE_MYSQL_PORT, TICKET_OFFICE_MYSQL_USER,
#   TICKET_OFFICE_MYSQL_PASSWORD, TICKET_OFFICE_MYSQL_DATABASE
# HTTP port: set PORT at runtime, or TICKET_OFFICE_SERVICE_PORT (this image sets PORT from it).

FROM node:26-alpine@sha256:e88a35be04478413b7c71c455cd9865de9b9360e1f43456be5951032d7ac1a66

ENV NODE_ENV=production

RUN apk upgrade --no-cache \
    && addgroup -S train-ticket \
    && adduser -S -G train-ticket -u 10001 train-ticket

WORKDIR /app

COPY ts-ticket-office-service/package.json ts-ticket-office-service/package-lock.json ./
RUN npm ci --omit=dev \
    && npm cache clean --force \
    && rm -rf /usr/local/lib/node_modules/npm /usr/local/bin/npm /usr/local/bin/npx

COPY ts-ticket-office-service/app.js ./
COPY ts-ticket-office-service/bin ./bin
COPY ts-ticket-office-service/public ./public

RUN chown -R train-ticket:train-ticket /app
USER train-ticket:train-ticket

ARG TICKET_OFFICE_SERVICE_PORT
ENV TICKET_OFFICE_SERVICE_PORT=${TICKET_OFFICE_SERVICE_PORT}
ENV PORT=${TICKET_OFFICE_SERVICE_PORT}

EXPOSE ${TICKET_OFFICE_SERVICE_PORT}

HEALTHCHECK --interval=10s --timeout=5s --retries=10 \
    CMD node -e "const port = process.env.PORT || process.env.TICKET_OFFICE_SERVICE_PORT; if (!port) process.exit(1); require('http').get('http://127.0.0.1:' + port + '/office', r => process.exit(r.statusCode < 500 ? 0 : 1)).on('error', () => process.exit(1))"

CMD ["node", "bin/www"]
