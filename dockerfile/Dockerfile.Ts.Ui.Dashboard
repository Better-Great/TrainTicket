# ts-ui-dashboard: OpenResty/nginx frontend.
# Build from repo root: docker build -f dockerfile/Dockerfile.Ts.Ui.Dashboard .
# Expects: ts-ui-dashboard/nginx.conf, ts-ui-dashboard/static/

FROM openresty/openresty:alpine

RUN apk add --no-cache tzdata
RUN cp /usr/share/zoneinfo/Asia/Shanghai /etc/localtime 2>/dev/null || true
RUN echo Asia/Shanghai >/etc/timezone 2>/dev/null || true

COPY ts-ui-dashboard/nginx.conf /usr/local/openresty/nginx/conf/nginx.conf
COPY ts-ui-dashboard/static /usr/share/nginx/html

EXPOSE 8080
CMD ["/usr/local/openresty/bin/openresty", "-g", "daemon off;"]
