# ts-ui-dashboard: nginx serves static/; proxies /api/v1/ to ts-gateway-service.
# Build from repo root:
#   docker build -f dockerfile/Dockerfile.Ts.Ui.Dashboard .

FROM nginx:1.26-alpine

COPY ts-ui-dashboard/nginx.conf /etc/nginx/nginx.conf
COPY ts-ui-dashboard/static/ /usr/share/nginx/html/

EXPOSE 8080
