# Unified UI image: SPA (Bun build) + legacy static + nginx edge.
# Build from repo root:
#   docker build -f dockerfile/Dockerfile.Ts.Ui.Dashboard -t ts-ui-web .
# Or from this package:
#   docker build -f ts-ui-web/Dockerfile -t ts-ui-web ts-ui-web

FROM oven/bun:1.3.14 AS spa
WORKDIR /app
COPY ts-ui-web/package.json ts-ui-web/bun.lock ./
RUN bun install --frozen-lockfile
COPY ts-ui-web/ ./
ENV VITE_USE_MOCK=false
RUN bun run build

FROM nginx:1.26-alpine
COPY ts-ui-web/edge/nginx.conf /etc/nginx/nginx.conf
COPY --from=spa /app/dist/ /usr/share/nginx/html/
COPY ts-ui-web/legacy/ /usr/share/nginx/html/legacy/
EXPOSE 8080
