# Production-ready ts-travel-plan-service.
# Expects JARs in jar/: ts-travel-plan-service.jar, ts-token-replacement-service.jar
# Run: mount properties at /app/external-config, set ENVIRONMENT (docker|dev|prod).

FROM eclipse-temurin:17-jre-alpine

ENV JAR_NAME="ts-travel-plan-service.jar" \
    TOKEN_JAR_NAME="ts-token-replacement-service.jar" \
    APP_HOME="/app" \
    CONFIG_DIR="/app/config" \
    TEMPLATE_DIR="/app/templates" \
    JAR_DIR="/app/jar" \
    LOGS_DIR="/app/logs" \
    PROJECT_ROOT="/app/project" \
    EXTERNAL_CONFIG_DIR="/app/external-config" \
    ENVIRONMENT="${ENVIRONMENT:-docker}" \
    TZ="${TZ:-UTC}" \
    PORT="${PORT:-14322}"

RUN apk add --no-cache tzdata wget && \
    adduser -D -h "${APP_HOME}" -s /bin/sh train-ticket && \
    mkdir -p "${JAR_DIR}" "${CONFIG_DIR}" "${TEMPLATE_DIR}" "${LOGS_DIR}" "${EXTERNAL_CONFIG_DIR}" && \
    chown -R train-ticket:train-ticket "${APP_HOME}"

COPY --chown=train-ticket:train-ticket jar/ts-travel-plan-service.jar jar/ts-token-replacement-service.jar ${JAR_DIR}/
COPY --chown=train-ticket:train-ticket dockerfile/templates/ts-travel-plan-service/application.properties.ini ${TEMPLATE_DIR}/
RUN chmod 444 ${JAR_DIR}/*.jar ${TEMPLATE_DIR}/application.properties.ini

RUN echo '#!/bin/sh' > /entrypoint.sh && \
    echo 'set -e' >> /entrypoint.sh && \
    echo 'PROP_FILE="${EXTERNAL_CONFIG_DIR}/${ENVIRONMENT}.application.ini"' >> /entrypoint.sh && \
    echo 'if [ ! -f "$PROP_FILE" ]; then echo "Error: No env config at $PROP_FILE"; ls -la "${EXTERNAL_CONFIG_DIR}/" 2>/dev/null || true; exit 1; fi' >> /entrypoint.sh && \
    echo 'mkdir -p "${PROJECT_ROOT}/properties" "${PROJECT_ROOT}/ts-travel-plan-service/src/main/resources"' >> /entrypoint.sh && \
    echo 'cp "$PROP_FILE" "${PROJECT_ROOT}/properties/${ENVIRONMENT}.application.ini"' >> /entrypoint.sh && \
    echo 'cp "${TEMPLATE_DIR}/application.properties.ini" "${PROJECT_ROOT}/ts-travel-plan-service/"' >> /entrypoint.sh && \
    echo 'java -jar "${JAR_DIR}/${TOKEN_JAR_NAME}" "${ENVIRONMENT}" "${PROJECT_ROOT}"' >> /entrypoint.sh && \
    echo 'if [ ! -f "${PROJECT_ROOT}/ts-travel-plan-service/src/main/resources/application.properties" ]; then echo "Error: Token replacement failed"; exit 1; fi' >> /entrypoint.sh && \
    echo 'cp "${PROJECT_ROOT}/ts-travel-plan-service/src/main/resources/application.properties" "${CONFIG_DIR}/application-external.properties"' >> /entrypoint.sh && \
    echo 'chmod 600 "${CONFIG_DIR}/application-external.properties"' >> /entrypoint.sh && \
    echo 'exec java ${JAVA_OPTS:--Xmx256m -Xms128m} -jar "${JAR_DIR}/${JAR_NAME}" \' >> /entrypoint.sh && \
    echo '  --spring.config.location=file:${CONFIG_DIR}/application-external.properties \' >> /entrypoint.sh && \
    echo '  --server.port="${PORT:-14322}" \' >> /entrypoint.sh && \
    echo '  --logging.file.name=${LOGS_DIR}/ts-travel-plan-service.log \' >> /entrypoint.sh && \
    echo '  --logging.file.max-size=10MB --logging.file.max-history=5' >> /entrypoint.sh && \
    chmod 755 /entrypoint.sh

WORKDIR ${CONFIG_DIR}
USER train-ticket
EXPOSE 14322

HEALTHCHECK --interval=30s --timeout=5s --start-period=90s --retries=3 \
    CMD wget -q -O /dev/null "http://127.0.0.1:${PORT:-14322}/actuator/health" || exit 1

ENTRYPOINT ["/entrypoint.sh"]
