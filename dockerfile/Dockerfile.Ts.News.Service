# ts-news-service: Go HTTP service.
# Build from repo root: docker build -f dockerfile/Dockerfile.Ts.News.Service .
# Expects: ts-news-service/src/main/main.go, ts-news-service/src/main/lib.go

FROM golang:1.23-alpine AS builder
RUN apk add --no-cache ca-certificates
WORKDIR /app
COPY ts-news-service/src/main/main.go ts-news-service/src/main/lib.go ./
RUN go mod init ts-news-service 2>/dev/null || true && \
    go get github.com/hoisie/web && \
    go build -o /news-service .

FROM alpine:3.18
RUN apk add --no-cache ca-certificates tzdata
RUN addgroup -S app && adduser -S -G app app
WORKDIR /app
COPY --from=builder /news-service .
RUN chown app:app /news-service
USER app
EXPOSE 12862
CMD ["./news-service"]
