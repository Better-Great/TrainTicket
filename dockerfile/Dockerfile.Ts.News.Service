# ts-news-service: Go HTTP service (net/http only).
# Build from repo root: docker build -f dockerfile/Dockerfile.Ts.News.Service .
# Runtime: Alpine with shell; static binary.

FROM golang:1.26.5-alpine@sha256:0178a641fbb4858c5f1b48e34bdaabe0350a330a1b1149aabd498d0699ff5fb2 AS build
WORKDIR /src
COPY ts-news-service/go.mod ./
COPY ts-news-service/main.go ./
RUN CGO_ENABLED=0 go build -trimpath -ldflags="-s -w" -o /news .

FROM alpine:3.22@sha256:14358309a308569c32bdc37e2e0e9694be33a9d99e68afb0f5ff33cc1f695dce
RUN apk upgrade --no-cache \
    && addgroup -S train-ticket \
    && adduser -S -G train-ticket -u 1000 train-ticket
WORKDIR /
COPY --from=build /news /news
RUN chown train-ticket:train-ticket /news && chmod 0555 /news
USER train-ticket:train-ticket
ENV NEWS_SERVICE_PORT=${NEWS_SERVICE_PORT}
EXPOSE ${NEWS_SERVICE_PORT}
HEALTHCHECK --interval=10s --timeout=5s --retries=10 \
    CMD wget -qO- "http://127.0.0.1:${NEWS_SERVICE_PORT}/" > /dev/null || exit 1
ENTRYPOINT ["/news"]
