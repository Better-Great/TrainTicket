# ts-avatar-service — OpenCV Haar, wheels only (no dlib build).
# Build from repo root:
#   docker build -f dockerfile/Dockerfile.Ts.Avatar.Service .
#
# Runtime: `env_file` in compose and/or `--env-file`; optional bind-mount `.env` to
# `/home/app/app/.env` (file is gitignored and not copied into the image).

FROM cgr.dev/chainguard/python:latest-dev@sha256:bee63d1fd86c4b31dd2df85bb383be142e8067486e3d469265edb850af93e8e4

LABEL com.trainticket.avatar.endpoints='{"service":"ts-avatar-service","health":"/health","avatar_post":"/api/v1/avatar"}'

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    HOME=/home/app \
    APP_HOME=/home/app/app \
    PATH=/venv/bin:${PATH}

ENV AVATAR_SERVICE_PORT=${AVATAR_SERVICE_PORT}

USER root
RUN python -m venv /venv

WORKDIR ${APP_HOME}

COPY ts-avatar-service/requirements.txt ./
RUN pip install --no-cache-dir -r requirements.txt

COPY ts-avatar-service/ .
RUN mkdir -p received images \
    && chown -R 65532:65532 /venv /home/app

USER 65532:65532

EXPOSE ${AVATAR_SERVICE_PORT}

HEALTHCHECK --interval=10s --timeout=5s --retries=10 \
    CMD ["/venv/bin/python", "-c", "import os,urllib.request; urllib.request.urlopen('http://127.0.0.1:' + os.environ['AVATAR_SERVICE_PORT'] + '/health', timeout=3)"]

ENTRYPOINT ["/bin/sh", "-c"]
CMD ["exec /venv/bin/gunicorn -w 2 -b 0.0.0.0:${AVATAR_SERVICE_PORT} --timeout 120 --chdir \"${APP_HOME}\" app:app"]
