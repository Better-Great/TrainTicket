# Copy to `.env` and adjust. Required for `./run-local.sh` (sourced before starting Flask).
# Docker: use repo-root `env_file: .env` in compose, or bind-mount this file to `/home/app/app/.env`.

# Port for Flask (dev) and gunicorn (Docker). Also accepts generic PORT.
AVATAR_SERVICE_PORT=17001

# Bind address for python app.py only (gunicorn always binds 0.0.0.0 in Docker).
# Do not set this to 0.0.0.0 in the gateway’s env: there AVATAR_SERVICE_HOST is the upstream hostname.
AVATAR_SERVICE_HOST=0.0.0.0

FLASK_DEBUG=true
# Leave false on WSL/macOS: the debug reloader forks and often breaks dlib/OpenCV.
FLASK_USE_RELOADER=false
LOG_LEVEL=INFO

# Set true to write ./images/img_face_*.jpg on each request (was always on before).
AVATAR_SAVE_DEBUG_IMAGES=false
