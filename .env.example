# Copy to .env — see docs/GETTING-STARTED.md. Docker: ./scripts/up-docker.sh
#
# SECURITY: every credential below is a LOCAL DEV DEFAULT ONLY (matches scripts/*.sh
# and properties/*.ini so the stack works out of the box). Never reuse these values
# outside a local machine — generate real secrets instead, e.g.: openssl rand -hex 32

# General (for full docker-compose and docker-compose.build.yml push to Docker Hub)
IMG_REPO=bettergreat
IMG_TAG=0.2.0
TAG=1.0
NAMESPACE=dev

# MySQL
MYSQL_IMAGE=mysql:8.0
MYSQL_CONTAINER=trainticket-mysql
MYSQL_ROOT_PASSWORD=root
MYSQL_USER=beta
MYSQL_PASSWORD=beta123
MYSQL_PORT=3307
MYSQL_INIT_SCRIPT=./docker/mysql-init.sql

# Nacos
NACOS_IMAGE=nacos/nacos-server:v2.1.0
NACOS_CONTAINER=nacos-standalone
NACOS_HTTP_PORT=8848
NACOS_GRPC_PORT=9848
NACOS_P2P_PORT=9849
NACOS_MODE=standalone
SPRING_DATASOURCE_PLATFORM=embedded

# RabbitMQ
RABBITMQ_IMAGE=rabbitmq:3-management
RABBITMQ_CONTAINER=trainticket-rabbitmq
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest
RABBITMQ_AMQP_PORT=5672
RABBITMQ_HTTP_PORT=15672

# Redis
REDIS_IMAGE=redis:latest
REDIS_CONTAINER=trainticket-redis
REDIS_PORT=6379

# Kafka
KAFKA_IMAGE=spotify/kafka:latest
KAFKA_CONTAINER=trainticket-kafka
ZOOKEEPER_PORT=2181
KAFKA_PORT=9092

# Zipkin
ZIPKIN_IMAGE=openzipkin/zipkin:latest
ZIPKIN_CONTAINER=trainticket-zipkin
ZIPKIN_PORT=9411

# Security (Stage C / TT-511) — override in real .env; never commit real secrets
JWT_SECRET=change-me-local-dev-only
GATEWAY_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8080

# docker-compose.build.yml (use docker for Docker network)
ENVIRONMENT=docker
AUTH_SERVICE_PORT=12349
GATEWAY_SERVICE_PORT=18888
TZ=UTC

# Non-Java services
UI_DASHBOARD_PORT=8080
AVATAR_SERVICE_PORT=17001
VOUCHER_SERVICE_PORT=16101
VOUCHER_MYSQL_HOST=mysql
VOUCHER_MYSQL_PORT=3307
VOUCHER_MYSQL_USER=beta
VOUCHER_MYSQL_PASSWORD=beta123
VOUCHER_MYSQL_DATABASE=ts-voucher-mysql
TICKET_OFFICE_SERVICE_PORT=16108
TICKET_OFFICE_MYSQL_HOST=mysql
TICKET_OFFICE_MYSQL_PORT=3307
TICKET_OFFICE_MYSQL_USER=beta
TICKET_OFFICE_MYSQL_PASSWORD=beta123
TICKET_OFFICE_MYSQL_DATABASE=ts-ticket-office-mysql
NEWS_SERVICE_PORT=12862
