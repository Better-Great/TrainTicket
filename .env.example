# Docker Compose - minimal dependencies (docker-compose.minimal.yml)
# Copy to .env and override as needed.

# General (for full docker-compose)
IMG_REPO=codewisdom
IMG_TAG=0.2.0
TAG=1.0
NAMESPACE=dev

# MySQL
MYSQL_IMAGE=mysql:8.0
MYSQL_CONTAINER=trainticket-mysql
MYSQL_ROOT_PASSWORD=root
MYSQL_USER=beta
MYSQL_PASSWORD=beta123
MYSQL_PORT=3307
MYSQL_INIT_SCRIPT=./docker/mysql-init.sql

# Nacos
NACOS_IMAGE=nacos/nacos-server:v2.1.0
NACOS_CONTAINER=nacos-standalone
NACOS_HTTP_PORT=8848
NACOS_GRPC_PORT=9848
NACOS_P2P_PORT=9849
NACOS_MODE=standalone
SPRING_DATASOURCE_PLATFORM=embedded

# RabbitMQ
RABBITMQ_IMAGE=rabbitmq:3-management
RABBITMQ_CONTAINER=trainticket-rabbitmq
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest
RABBITMQ_AMQP_PORT=5672
RABBITMQ_HTTP_PORT=15672

# Redis
REDIS_IMAGE=redis:latest
REDIS_CONTAINER=trainticket-redis
REDIS_PORT=6379

# Kafka
KAFKA_IMAGE=spotify/kafka:latest
KAFKA_CONTAINER=trainticket-kafka
ZOOKEEPER_PORT=2181
KAFKA_PORT=9092

# Zipkin
ZIPKIN_IMAGE=openzipkin/zipkin:latest
ZIPKIN_CONTAINER=trainticket-zipkin
ZIPKIN_PORT=9411
